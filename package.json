{
  "name": "edu-blocks",
  "version": "0.1.0",
  "description": "Ігрове блокове програмування для 3–6 класу: рівні, кристали, блоки як у Scratch 3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.lib.config.ts --mode core && tsc -p tsconfig.lib.json && node scripts/third-party-licenses.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tiled": "node --experimental-transform-types --no-warnings scripts/tiled-to-level.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavada123/edu-blocks.git"
  },
  "files": [
    "lib",
    "assets",
    "!assets/*/audio",
    "!assets/*/preview"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./core": {
      "types": "./lib/types/core.d.ts",
      "import": "./lib/core.js"
    },
    "./react": {
      "types": "./lib/types/react.d.ts",
      "import": "./lib/react.js"
    },
    "./python": {
      "types": "./lib/types/python.d.ts",
      "import": "./lib/python.js"
    },
    "./style.css": "./lib/style.css",
    "./blocks-media/*": "./lib/blocks-media/*",
    "./assets/*": "./assets/*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scratch-blocks": "1.3.0",
    "scratch-vm": "github:TurboWarp/scratch-vm#f26ff67e951258a84d25cad3acaf8804eb202318",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
