{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src/core.ts", "src/react.ts", "src/**/*.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
